{
    "version": 2,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/docs",
            "dest": "/public/docs/index.html"
        },
        {
            "src": "/docs/(.*)",
            "dest": "/public/docs/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/(.*\\.(ico|txt|webp|png|jpg|svg|woff|woff2|ttf|eot))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Vibora Padel Store",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:1xPP40142C6Tf3rMMZ2iKEfRA2j5QWVrxlLh1u2Ybbw=",
        "VERCEL_DEMO_MODE": "false",
        "CLOUDINARY_URL": "cloudinary://422976997539976:9bAYApf6YGEBxEekipFG1bjnZaI@domliw6oo",
        "APP_CONFIG_CACHE": "/tmp/config_v2.php",
        "APP_EVENTS_CACHE": "/tmp/events_v2.php",
        "APP_PACKAGES_CACHE": "/tmp/packages_v2.php",
        "APP_ROUTES_CACHE": "/tmp/routes_v2.php",
        "APP_SERVICES_CACHE": "/tmp/services_v2.php",
        "CACHE_DRIVER": "array",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "database",
        "VIEW_COMPILED_PATH": "/tmp",
        "SSR_TEMP_PATH": "/tmp/ssr",
        "NODE_PATH": "node"
    }
}